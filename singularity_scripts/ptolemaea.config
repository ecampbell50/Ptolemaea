#!/bin/bash
# ptolemaea.config
# =============================================================================
# ONE place to configure the containerised Ptolemaea pipeline.
# Edit the paths for your system, and the image tags to change tool versions.
# Sourced automatically by pipeline_functions.sh.
# =============================================================================

# --- Host paths (EDIT FOR YOUR SYSTEM) ---------------------------------------
# ":-" sets variable to current value if present, otherwise sets to path

# Directory that holds the .sif images (pulled with `apptainer pull`).
PTOL_IMAGE_DIR="${PTOL_IMAGE_DIR:-/mnt/scratch2/users/40204129/Ptolemaea_Singularity/images}"

# Host path(s) bound into EVERY container. Must cover the working dir, genomes,
# databases and outputs. SITE-SPECIFIC (Kelvin uses /mnt/scratch2 — not
# auto-mounted by Apptainer, so it MUST be bound explicitly). Override with the
# PTOL_BIND env var on other systems.
PTOL_BIND="${PTOL_BIND:-/mnt/scratch2}"

# Persistent, WRITABLE database locations on the host. Populated ONCE, with
# internet, before the first pipeline run (see README / one-time DB setup):
#   PADLOC : apptainer exec --bind $PTOL_BIND \
#              --bind $PTOL_PADLOC_DATA:/usr/local/data $img padloc --db-update
#   DefFnd : apptainer exec --bind $PTOL_BIND $img \
#              defense-finder update --models-dir $PTOL_DF_MODELS
PTOL_PADLOC_DATA="${PTOL_PADLOC_DATA:-/mnt/scratch2/users/40204129/Ptolemaea_Singularity/padloc_data}"
PTOL_DF_MODELS="${PTOL_DF_MODELS:-/mnt/scratch2/users/40204129/Ptolemaea_Singularity/df_models}"

# --- Image filenames / tool versions -----------------------------------------
# To change a version: re-pull that tag into PTOL_IMAGE_DIR and update the name.
# These defaults are the PAPER/THESIS versions — keep unless deliberately upgrading.
PTOL_IMG_PYRODIGAL="${PTOL_IMG_PYRODIGAL:-pyrodigal.sif}"        # pyrodigal 3.7.1
PTOL_IMG_PADLOC="${PTOL_IMG_PADLOC:-padloc.sif}"                 # padloc 2.0.0  (DB v2.0.0)
PTOL_IMG_DEFENSEFINDER="${PTOL_IMG_DEFENSEFINDER:-defensefinder.sif}"  # DefenseFinder 2.0.1
PTOL_IMG_BLAST="${PTOL_IMG_BLAST:-blast.sif}"                    # BLAST 2.16.0
PTOL_IMG_PANDAS="${PTOL_IMG_PANDAS:-pandas.sif}"                 # pandas (consensus/matrix)

# !!! DEFENSEFINDER <-> MODELS COUPLING — read before upgrading !!!
# DefenseFinder and its models share a format and MUST move together:
#   DF 2.0.x  <->  defense-finder-models 2.x   (thesis: DF 2.0.1 + models 2.0.2)
#   DF 3.0.0  <->  defense-finder-models 3.1.0
# Bumping PTOL_IMG_DEFENSEFINDER to a 3.x image therefore ALSO requires re-running
# `defense-finder update` to refresh $PTOL_DF_MODELS to matching 3.x models.
# Changing only one of the two will crash with a model-version-mismatch error.

# --- Derived: base apptainer exec command (do not normally edit) -------------
PTOL_APPTAINER="apptainer exec --bind ${PTOL_BIND}"

# Run python (consensus/matrix steps) inside the pandas image.
ptol_python() {
    ${PTOL_APPTAINER} "${PTOL_IMAGE_DIR}/${PTOL_IMG_PANDAS}" python "$@"
}
